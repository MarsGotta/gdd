#!/bin/sh
# GDD entry point: the gdd binary built from the main branch. See bin/gdd help.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# Rust toolchain installed with rustup lives in ~/.cargo/bin (the gate commands need it).
[ -d "$HOME/.cargo/bin" ] && PATH="$HOME/.cargo/bin:$PATH" && export PATH
# The Orchestrator installs it after each merge, on main:
#   cargo build --release --locked && install -m 755 target/release/gdd .gdd/bin/gdd-rust
# Never from a change branch: a Builder could rewrite its own judge. CI builds it from main too.
BIN="$ROOT/.gdd/bin/gdd-rust"
if [ ! -x "$BIN" ]; then
  echo "error: $BIN is missing. On main: cargo build --release --locked && install -m 755 target/release/gdd .gdd/bin/gdd-rust" >&2
  exit 1
fi
exec "$BIN" "$@"
