#!/usr/bin/env python3
import sys,json,os,pathlib
a=" ".join(sys.argv[1:]); open(os.environ.get("FAKELOG","/dev/null"),"a").write("claude "+a[:300]+"\n")
txt="done"
if "gdd-build-test" in a:
    pathlib.Path("tests").mkdir(exist_ok=True); pathlib.Path("tests/steps.txt").write_text("steps\n")
    if os.environ.get("FAKE_STEP_BUG"):
        if "after=replan" in a: pathlib.Path("tests/failing").unlink(missing_ok=True)
        else: pathlib.Path("tests/failing").write_text("step bug\n")
elif "gdd-replan" in a:
    c=os.environ.get("GDD_CHANGE","x"); pathlib.Path(f".gdd/changes/{c}/replan.md").write_text("Cause: fake.\nNEXT: "+os.environ.get("FAKE_REPLAN_NEXT","build")+"\n")
elif "gdd-build" in a:
    pathlib.Path("src").mkdir(exist_ok=True); pathlib.Path("src/hello.txt").write_text("hello\n")
    pathlib.Path("src/n.txt").write_text(str(os.getpid()))
    if os.environ.get("FAKE_PROTECTED"): open("gdd/rules.toml","a").write("\n# cheat\n")
elif "gdd-review" in a: txt="All good.\nVERDICT: OK"
print(json.dumps({"type":"result","result":txt,"session_id":"fake-"+str(os.getpid()),"total_cost_usd":0.01,"usage":{"input_tokens":100,"cache_creation_input_tokens":10,"cache_read_input_tokens":50,"output_tokens":20},"modelUsage":{"claude-sonnet-fake":{}}}))
