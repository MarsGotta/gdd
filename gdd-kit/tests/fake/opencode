#!/usr/bin/env python3
import sys,json,os,pathlib
a=" ".join(sys.argv[1:]); open(os.environ.get("FAKELOG","/dev/null"),"a").write("opencode "+a[:300]+"\n")
a=a.replace("gdd.","gdd-")   # opencode names commands with dots (speckit.gdd.build)
txt="done"
if "gdd-build-test" in a: pathlib.Path("tests").mkdir(exist_ok=True); pathlib.Path("tests/steps.txt").write_text("steps\n")
elif "gdd-build" in a:
    pathlib.Path("src").mkdir(exist_ok=True); pathlib.Path("src/hello.txt").write_text("hello\n")
    pathlib.Path("src/n.txt").write_text(str(os.getpid()))
    if os.environ.get("FAKE_PROTECTED"): open("gdd/rules.toml","a").write("\n# cheat\n")
elif "gdd-review" in a: txt="All good.\nVERDICT: OK"
print(json.dumps({"type":"result","result":txt,"session_id":"fake-"+str(os.getpid()),"total_cost_usd":0.01,"usage":{"input_tokens":100,"cache_creation_input_tokens":10,"cache_read_input_tokens":50,"output_tokens":20},"modelUsage":{"claude-sonnet-fake":{}}}))
