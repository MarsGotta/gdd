{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "bash": {
      "*": "deny",
      "bin/gdd g2*": "allow",
      "bin/gdd guard*": "allow",
      "bin/gdd note*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow"
    }
  }
}
